    initAllStreams();
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') initAllStreams(); });
    function toggleMeta(metaId) { document.getElementById(metaId).classList.toggle('active'); }
    function requestNativeFullscreen() {
      const docEl = document.documentElement;
      if (docEl.requestFullscreen) docEl.requestFullscreen().catch(() => {});
      else if (docEl.webkitRequestFullscreen) docEl.webkitRequestFullscreen().catch(() => {});
    }
    function exitNativeFullscreen() {
      if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen().catch(() => {});
    }
    function showCameraByIndex(index) {
      const targetBox = camBoxes[index];
      const container = document.getElementById('camContainer');
      container.classList.add('single-mode');
      camBoxes.forEach(b => { b.classList.remove('active'); b.querySelector('.fullscreen-btn').innerText = '⛶'; });
      targetBox.classList.add('active');
      targetBox.querySelector('.fullscreen-btn').innerText = '🗗';
    }
    function toggleSolo(boxId) {
      const container = document.getElementById('camContainer');
      const targetBox = document.getElementById(boxId);
      if (container.classList.contains('single-mode') && targetBox.classList.contains('active')) {
        container.classList.remove('single-mode');
        targetBox.classList.remove('active');
        targetBox.querySelector('.fullscreen-btn').innerText = '⛶';
        exitNativeFullscreen();
      } else {
        const idx = parseInt(targetBox.getAttribute('data-index'), 10);
        showCameraByIndex(idx);
        requestNativeFullscreen();
      }
    }
    let touchStartX = 0, touchStartY = 0;
    document.addEventListener('touchstart', (e) => { if (e.touches.length === 1) { touchStartX = e.changedTouches[0].screenX; touchStartY = e.changedTouches[0].screenY; } }, false);
    document.addEventListener('touchend', (e) => {
      const container = document.getElementById('camContainer');
      if (!container.classList.contains('single-mode') || e.touches.length > 0) return;
      const deltaX = e.changedTouches[0].screenX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;
      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 60) {
        const activeBox = document.querySelector('.cam-box.active');
        if (!activeBox) return;
        let currentIndex = parseInt(activeBox.getAttribute('data-index'), 10);
        currentIndex = deltaX < 0 ? (currentIndex + 1) % camBoxes.length : (currentIndex - 1 + camBoxes.length) % camBoxes.length;
        showCameraByIndex(currentIndex);
      }
    }, false);
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        const container = document.getElementById('camContainer');
        container.classList.remove('single-mode');
        camBoxes.forEach(b => { b.classList.remove('active'); b.querySelector('.fullscreen-btn').innerText = '⛶'; });
      }
    });
  </script>
</body>
</html>`;

// --- PROCESS SUPERVISOR WITH CLEAN EXIT GUARD ---
const processes = [];
const MAX_RAPID_RETRIES = 5;
const STABILITY_THRESHOLD_MS = 10000;

function checkActiveStreams() {
  const ffmpegProcesses = processes.filter((p) => p.isFFmpeg);
  const activeFFmpegs = ffmpegProcesses.filter((p) => p.active);

  if (ffmpegProcesses.length > 0 && activeFFmpegs.length === 0) {
    log.error('All camera streams failed after maximum retry attempts.');
    log.error(`Check ${fmt.bold}${LOG_FILE}${fmt.reset} for full details. Exiting Helios completely.`);
    shutdown(1);
  }
}

function spawnManagedProcess(name, command, args, isFFmpeg = false, extraEnv = {}, options = {}) {
  let procEntry = processes.find((p) => p.name === name);

  if (!procEntry) {
    procEntry = {
      name,
      command,
      args,
      isFFmpeg,
      child: null,
      active: true,
      retryCount: 0,
      startTime: Date.now(),
    };
    processes.push(procEntry);
  }

  procEntry.startTime = Date.now();
  const retryLabel = procEntry.retryCount > 0 ? ` [Retry #${procEntry.retryCount}/${MAX_RAPID_RETRIES}]` : '';
  log.info(`Launching ${fmt.bold}${name}${fmt.reset}${retryLabel}...`);

  const child = spawn(command, args, {
    stdio: ['ignore', 'pipe', 'pipe'],
    env: { ...process.env, ...extraEnv },
    ...options,
  });
  procEntry.child = child;

  child.stdout.on('data', (d) => logToFile(name, d));
  child.stderr.on('data', (d) => logToFile(name, d));

  child.on('exit', (code, signal) => {
    logToFile(name, `Process exited (code ${code}, signal ${signal})`);
    if (!procEntry.active) return;

    const runtime = Date.now() - procEntry.startTime;

    if (runtime >= STABILITY_THRESHOLD_MS) {
      logToFile(name, `Process ran stably for ${(runtime / 1000).toFixed(1)}s. Resetting retry count.`);
      procEntry.retryCount = 0;
    } else {
      procEntry.retryCount++;
    }

    if (procEntry.retryCount > MAX_RAPID_RETRIES) {
      procEntry.active = false;
      log.error(`Process ${fmt.bold}${name}${fmt.reset} failed repeatedly (${procEntry.retryCount} rapid crashes). Disabling process.`);
      checkActiveStreams();
      return;
    }

    const backoffMs = Math.pow(2, procEntry.retryCount - 1) * 1000;
    log.warn(`Process ${fmt.bold}${name}${fmt.reset} exited after ${(runtime / 1000).toFixed(1)}s. Restarting in ${backoffMs / 1000}s...`);

    setTimeout(() => {
      if (procEntry.active) {
        spawnManagedProcess(name, command, args, isFFmpeg, extraEnv, options);
      }
    }, backoffMs);
  });

  return child;
}

// --- DETERMINISTIC TCP PORT HEALTH CHECK ---
function waitForPort(port, host = '127.0.0.1', timeoutMs = 10000) {
  return new Promise((resolve, reject) => {
    const startTime = Date.now();

    const tryConnect = () => {
      const socket = connect(port, host);

      socket.on('connect', () => {
        socket.end();
        resolve();
      });

      socket.on('error', () => {
        if (Date.now() - startTime > timeoutMs) {
          reject(new Error(`Timeout waiting for ${host}:${port}`));
        } else {
          setTimeout(tryConnect, 250);
        }
      });
    };

    tryConnect();
  });
}

// 1. Kill lingering MediaMTX instances
try {
  execSync('killall mediamtx', { stdio: 'ignore' });
} catch (e) {}

// 2. Prevent macOS sleep
spawnManagedProcess('Caffeinate', 'caffeinate', ['-i', '-s']);

// 3. Launch MediaMTX Server inside OS /tmp so auto.crt / auto.key land in /tmp
spawnManagedProcess('MediaMTX Server', mediamtxBin, [TEMP_CONFIG_PATH], false, {}, { cwd: tmpdir() });

// 4. Deterministically wait for MediaMTX RTSP port 8554 (IPv4) to accept connections
log.info('Waiting for MediaMTX RTSP listener socket...');
try {
  await waitForPort(8554, '127.0.0.1');
  log.success('MediaMTX socket ready.');
} catch (err) {
  log.error(`MediaMTX failed to start on port 8554. See ${LOG_FILE}`);
  shutdown(1);
}

// 5. Launch FFmpeg encoders with explicit IPv4 target URLs
selectedDevices.forEach((dev, idx) => {
  const isBrio = dev.name.includes('MX Brio') || dev.name.includes('Brio');
  const resolution = isBrio ? '1920x1080' : '1280x720';
  const bitrate = isBrio ? '4M' : '2M';
  const streamName = `cam${idx + 1}`;

  const ffmpegArgs = [
    '-use_wallclock_as_timestamps', '1',
    '-copyts',
    '-f', 'avfoundation',
    '-pixel_format', 'nv12',
    '-framerate', '30',
    '-video_size', resolution,
    '-i', dev.name,
    '-r', '30',
    '-g', '30',
    '-keyint_min', '30',
    '-vf', 'setpts=N/(30*TB),format=yuv420p',
    '-vcodec', 'h264_videotoolbox',
    '-b:v', bitrate,
    '-rtsp_transport', 'tcp',
    '-f', 'rtsp',
    `rtsp://127.0.0.1:8554/${streamName}`
  ];

  spawnManagedProcess(`FFmpeg [${dev.name}]`, ffmpegBin, ffmpegArgs, true);
});

// 6. Launch Embedded Web Server
let server = null;
server = createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'text/html' });
  res.end(HTML_CONTENT);
});

server.listen(8000, () => {
  const localIP = getPrimaryLocalIP();
  log.header('Helios Streaming Toolset Ready');
  log.success(`Viewer live locally at: ${fmt.bold}${fmt.cyan}http://localhost:8000${fmt.reset}`);
  log.info(`Over local network / VPN, open: ${fmt.bold}${fmt.cyan}http://${localIP}:8000${fmt.reset}`);
  log.info(`All output logged to: ${fmt.bold}${LOG_FILE}${fmt.reset}`);
  console.log(`\n${fmt.dim}Press Ctrl+C to stop all Helios processes cleanly.${fmt.reset}\n`);
});

// --- CLEAN SHUTDOWN HANDLER ---
function shutdown(exitCode = 0) {
  log.header('Shutting down Helios...');
  processes.forEach((proc) => {
    proc.active = false;
    if (proc.child) proc.child.kill('SIGTERM');
  });
  if (server) server.close();
  if (existsSync(TEMP_CONFIG_PATH)) {
    try { unlinkSync(TEMP_CONFIG_PATH); } catch (e) {}
  }
  logStream.end();
  process.exit(exitCode);
}

process.on('SIGINT', () => shutdown(0));
process.on('SIGTERM', () => shutdown(0));