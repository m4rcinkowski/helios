import { createServer } from 'http';
import { connect } from 'net';
import readline from 'readline';
import { tmpdir, networkInterfaces } from 'os';
import { join } from 'path';

// --- COLOR & FORMATTING HELPERS ---
const fmt = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  cyan: '\x1b[36m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  red: '\x1b[31m',
  dim: '\x1b[2m',
  hideCursor: '\x1b[?25l',
  showCursor: '\x1b[?25h',
};

const log = {
  info: (msg) => console.log(`${fmt.cyan}ℹ${fmt.reset} ${msg}`),
  success: (msg) => console.log(`${fmt.green}✔${fmt.reset} ${msg}`),
  warn: (msg) => console.log(`${fmt.yellow}⚠${fmt.reset} ${msg}`),
  error: (msg) => console.log(`${fmt.red}✖${fmt.reset} ${msg}`),
  header: (msg) => console.log(`\n${fmt.bold}${fmt.cyan}=== ${msg} ===${fmt.reset}\n`),
};

// --- NETWORK INTERFACE RESOLVER ---
function getPrimaryLocalIP() {
  const interfaces = networkInterfaces();
  
  // Prefer standard physical interfaces (Wi-Fi / Ethernet on macOS: en0, en1)
  const preferredPrefixes = ['en', 'eth'];
  
  for (const prefix of preferredPrefixes) {
    for (const [name, addrs] of Object.entries(interfaces)) {
      if (name.startsWith(prefix) && addrs) {
        for (const addr of addrs) {
          const isIPv4 = addr.family === 'IPv4' || addr.family === 4;
          if (isIPv4 && !addr.internal) {
            return addr.address;
          }
        }
      }
    }
  }

  // Fallback: Return any non-internal IPv4 address
  for (const [name, addrs] of Object.entries(interfaces)) {
    if (addrs && !name.startsWith('utun') && !name.startsWith('bridge')) {
      for (const addr of addrs) {
        const isIPv4 = addr.family === 'IPv4' || addr.family === 4;
        if (isIPv4 && !addr.internal) {
          return addr.address;
        }
      }
    }
  }

  return '127.0.0.1';
}

// --- LOG FILE ROTATION ---
const LOG_FILE = 'helios.log';
const logStream = createWriteStream(LOG_FILE, { flags: 'w' });

function logToFile(source, data) {
  const time = new Date().toISOString();
  const text = data.toString().trim();
  if (text) {
    logStream.write(`[${time}] [${source}] ${text}\n`);
  }
}

log.header('Helios PetCam Launcher');
log.info(`Log file initialized: ${fmt.bold}${LOG_FILE}${fmt.reset}`);

