    </div>`).join('')}
  </div>
  <script>
    const host = window.location.hostname;
    const camBoxes = Array.from(document.querySelectorAll('.cam-box'));
    const connections = {};

    async function startStream(path, videoElement, timeElement, statsElement) {
      if (connections[path]) {
        try {
          clearInterval(connections[path].statsTimer);
          if (connections[path].rvfcId) videoElement.cancelVideoFrameCallback(connections[path].rvfcId);
          connections[path].pc.close();
        } catch (e) {}
      }
      const pc = new RTCPeerConnection();
      let lastBytes = 0, lastTimestamp = 0, lastFrameRenderTime = null;
      const onFrameRendered = () => {
        lastFrameRenderTime = new Date();
        if (videoElement.requestVideoFrameCallback) {
          connections[path].rvfcId = videoElement.requestVideoFrameCallback(onFrameRendered);
        }
      };
      if (videoElement.requestVideoFrameCallback) {
        connections[path] = connections[path] || {};
        connections[path].rvfcId = videoElement.requestVideoFrameCallback(onFrameRendered);
      } else {
        videoElement.addEventListener('timeupdate', () => { lastFrameRenderTime = new Date(); });
      }
      pc.addTransceiver('video', { direction: 'recvonly' });
      pc.ontrack = (event) => { videoElement.srcObject = event.streams[0]; };
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      try {
        const res = await fetch(\`http://\${host}:8889/\${path}/whep\`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/sdp' },
          body: offer.sdp
        });
        if (res.ok) {
          const answerSdp = await res.text();
          await pc.setRemoteDescription({ type: 'answer', sdp: answerSdp });
        } else {
          timeElement.innerText = 'Offline';
          statsElement.innerText = 'Stream Disconnected';
        }
      } catch (err) {
        timeElement.innerText = 'Error';
        statsElement.innerText = 'Connection Failed';
