      const statsTimer = setInterval(async () => {
        const now = new Date();
        if (lastFrameRenderTime) {
          const diffSeconds = Math.floor((now - lastFrameRenderTime) / 1000);
          if (diffSeconds >= 5) {
            const roundedStaleSeconds = Math.floor(diffSeconds / 5) * 5;
            timeElement.innerText = \`\${roundedStaleSeconds} seconds ago\`;
            timeElement.classList.add('stale');
          } else {
            timeElement.innerText = lastFrameRenderTime.toLocaleString();
            timeElement.classList.remove('stale');
          }
        } else {
          timeElement.innerText = 'Waiting for video...';
        }

        if (!pc || pc.connectionState !== 'connected') return;
        const stats = await pc.getStats();
        stats.forEach(report => {
          if (report.type === 'inbound-rtp' && report.kind === 'video') {
            const width = videoElement.videoWidth || 0;
            const height = videoElement.videoHeight || 0;
            const fps = report.framesPerSecond || 0;
            const reportNow = report.timestamp;
            const bytes = report.bytesReceived;
            let bitrate = 0;
            if (lastTimestamp > 0) bitrate = ((bytes - lastBytes) * 8) / (reportNow - lastTimestamp);
            lastBytes = bytes;
            lastTimestamp = reportNow;
            statsElement.innerText = \`\${width}x\${height} | \${fps} FPS | \${(bitrate / 1000).toFixed(1)} Mbps\`;
          }
        });
      }, 1000);
      connections[path] = { ...connections[path], pc, statsTimer };
    }

    function initAllStreams() {
      ${selectedDevices.map((_, i) => `
      startStream('cam${i + 1}', document.getElementById('video${i + 1}'), document.getElementById('time${i + 1}'), document.getElementById('stats${i + 1}'));`).join('')}
