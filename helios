// --- DEPENDENCY VALIDATION & PATH RESOLUTION ---
function findExecutable(cmd) {
  const commonPaths = [
    `/opt/homebrew/bin/${cmd}`,
    `/usr/local/bin/${cmd}`,
    `/usr/bin/${cmd}`,
  ];
  for (const p of commonPaths) {
    if (existsSync(p)) return p;
  }
  try {
    return execSync(`which ${cmd}`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    return null;
  }
}

const ffmpegBin = findExecutable('ffmpeg');
const mediamtxBin = findExecutable('mediamtx');

if (!ffmpegBin) {
  log.error(`Missing required dependency: ${fmt.bold}ffmpeg${fmt.reset}`);
  console.log(`  ${fmt.dim}Installation suggestion:${fmt.reset} brew install ffmpeg\n`);
  shutdown(1);
}

if (!mediamtxBin) {
  log.error(`Missing required dependency: ${fmt.bold}mediamtx${fmt.reset}`);
  console.log(`  ${fmt.dim}Installation suggestion:${fmt.reset} brew install mediamtx\n`);
  shutdown(1);
}

// --- DISCOVER AVFOUNDATION DEVICES ---
log.info('Enumerating video capture devices...');

function getAVDevices() {
  const devices = [];
  try {
    const rawOutput = execSync(`"${ffmpegBin}" -f avfoundation -list_devices true -i "" 2>&1`, {
      encoding: 'utf8',
      env: process.env,
    });

    const lines = rawOutput.split('\n');
    let inVideoSection = false;

    for (const line of lines) {
      if (line.includes('AVFoundation video devices:')) {
        inVideoSection = true;
        continue;
      }
      if (line.includes('AVFoundation audio devices:') || line.includes('AVFoundation video device options')) {
        inVideoSection = false;
        break;
      }

      if (inVideoSection) {
        const match = line.match(/\[(\d+)\]\s+(.+)$/);
        if (match) {
          const index = match[1];
          const name = match[2].trim();
          if (name && !name.includes('AVFoundation')) {
            devices.push({ index, name });
          }
        }
      }
    }
  } catch (e) {
    if (e.stdout || e.stderr) {
      const combined = (e.stdout || '') + (e.stderr || '');
      const lines = combined.split('\n');
      let inVideoSection = false;
      for (const line of lines) {
        if (line.includes('AVFoundation video devices:')) inVideoSection = true;
        if (line.includes('AVFoundation audio devices:')) inVideoSection = false;
        if (inVideoSection) {
          const match = line.match(/\[(\d+)\]\s+(.+)$/);
          if (match) {
            devices.push({ index: match[1], name: match[2].trim() });
          }
        }
      }
    }
  }
  return devices;
}

const availableDevices = getAVDevices();

if (availableDevices.length === 0) {
  log.error('No AVFoundation video capture devices detected.');
  shutdown(1);
}

// --- INTERACTIVE CHECKBOX UI ---
function selectDevicesInteractive(devices) {
  return new Promise((resolve) => {
    const selections = devices.map((d) => {
      const lower = d.name.toLowerCase();
      return !(lower.includes('screen') || lower.includes('capture'));
    });

    let cursor = 0;
    let initialRender = true;

    readline.emitKeypressEvents(process.stdin);
    if (process.stdin.isTTY) {
      process.stdin.setRawMode(true);
    }

    process.stdout.write(fmt.hideCursor);
    const totalLines = devices.length + 3;

    function render() {
      if (!initialRender) {
        readline.moveCursor(process.stdout, 0, -totalLines);
      }
      initialRender = false;

      console.log(`${fmt.bold}Select Capture Devices:${fmt.reset}`);
      console.log(`${fmt.dim}(Use Up/Down to navigate, Space to toggle, Enter to confirm)${fmt.reset}\n`);

      devices.forEach((dev, i) => {
        const isSelected = selections[i];
        const isCurrent = i === cursor;

        const checkbox = isSelected ? `${fmt.green}[x]${fmt.reset}` : `[ ]`;
        const pointer = isCurrent ? `${fmt.cyan}❯${fmt.reset}` : ' ';
        const nameStr = isCurrent ? `${fmt.bold}${dev.name}${fmt.reset}` : dev.name;

        const lower = dev.name.toLowerCase();
        const tag = (lower.includes('screen') || lower.includes('capture')) ? ` ${fmt.dim}(Screen Capture)${fmt.reset}` : '';

        readline.clearLine(process.stdout, 0);
        console.log(` ${pointer} ${checkbox} ${nameStr}${tag}`);
      });
    }

    render();

    function onKeypress(str, key) {
      if (!key) return;
      if (key.name === 'up') {
        cursor = (cursor - 1 + devices.length) % devices.length;
        render();
      } else if (key.name === 'down') {
        cursor = (cursor + 1) % devices.length;
        render();
      } else if (key.name === 'space') {
        selections[cursor] = !selections[cursor];
        render();
      } else if (key.name === 'return' || key.name === 'enter') {
        cleanup();
        const chosen = devices.filter((_, i) => selections[i]);
        resolve(chosen);
      } else if (key.ctrl && key.name === 'c') {
        cleanup();
        shutdown(0);
      }
    }

    function cleanup() {
      process.stdin.removeListener('keypress', onKeypress);
      if (process.stdin.isTTY) {
        process.stdin.setRawMode(false);
      }
      process.stdout.write(fmt.showCursor);
      console.log('');
    }

    process.stdin.on('keypress', onKeypress);
  });
}

const selectedDevices = await selectDevicesInteractive(availableDevices);

if (selectedDevices.length === 0) {
  log.warn('No devices selected. Exiting Helios.');
  shutdown(0);
}

log.success(`Selected ${selectedDevices.length} camera(s) for streaming.`);

